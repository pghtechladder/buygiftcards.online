# Database (Postgres). Get a free instance from Neon, Supabase, or Railway.
DATABASE_URL="postgresql://user:password@host:5432/buygiftcards?schema=public"

# Stripe — https://dashboard.stripe.com/test/apikeys (use test keys until you're ready to go live)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
# Created via `stripe listen --forward-to localhost:3000/api/webhooks/stripe` (dev)
# or the Dashboard's webhook endpoint settings (production)
STRIPE_WEBHOOK_SECRET="whsec_..."

# Resend — https://resend.com/api-keys (verify your sending domain before going live)
RESEND_API_KEY="re_..."
EMAIL_FROM="BuyGiftCards.online <orders@buygiftcards.online>"

# Logo.dev — brand logo images on product pages
NEXT_PUBLIC_LOGO_DEV_TOKEN="pk_ZgHE90OORwOmSiIo_lnp_A"

# Public site URL (used for Stripe redirect URLs + email links)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# SMTP — support-form notifications (src/lib/smtp.ts, /api/support). Configured
# for Zoho Mail by default; works with any standard SMTP provider.
# Zoho: use an app-specific password if 2FA is on (recommended) rather than
# your account password: https://accounts.zoho.com/home#security/app-passwords
SMTP_HOST="smtp.zoho.com"
SMTP_PORT="587"
SMTP_USER="support@buygiftcards.online"
SMTP_PASS="..."
SMTP_FROM="BuyGiftCards.online Support <support@buygiftcards.online>"
SUPPORT_INBOX_EMAIL="support@buygiftcards.online"

# ---------------------------------------------------------------------------
# Giftbit — RECOMMENDED live gift-card fulfillment provider
# ---------------------------------------------------------------------------
# $0 platform fee. Sign up free at https://app.giftbit.com/register
# API key: Dashboard → Profile → API keys (JWT token)
#   Testbed base URL:    https://api-testbed.giftbit.com/papi/v1 (default)
#   Production base URL: https://api.giftbit.com/papi/v1
# Once GIFTBIT_API_KEY is set, GiftbitProvider activates automatically and
# takes priority over Tango. Run `npm run giftbit:catalog` to fetch available
# brands and verify BRAND_TO_GIFTBIT_CODE in src/lib/giftcard-provider.ts.
# GIFTBIT_API_KEY="eyJ0eXAiOiJKV1Qi..."
# GIFTBIT_API_BASE_URL="https://api-testbed.giftbit.com/papi/v1"
# GIFTBIT_CLAIM_EXPIRY_DAYS="360"   # max 364 days; unclaimed links auto-expire and return 75% breakage credit

# ---------------------------------------------------------------------------
# Tango Card RaaS API — real gift-card fulfillment (src/lib/giftcard-provider.ts).
# Leave unset to keep running in demo mode (non-redeemable placeholder codes).
# Get these from Tango after your application is approved: https://developers.tangocard.com
# TANGO_API_BASE_URL="https://integration-api.tangocard.com/raas/v2"   # sandbox/integration default; switch to https://api.tangocard.com/raas/v2 for production
# TANGO_PLATFORM_NAME="..."
# TANGO_PLATFORM_KEY="..."
# TANGO_ACCOUNT_IDENTIFIER="..."
# TANGO_CUSTOMER_IDENTIFIER="..."

# Kit.com (formerly ConvertKit) — newsletter signups (src/lib/newsletter.ts,
# /api/subscribe, the entry popup). Leave unset and signups still save to
# our own database, just without syncing to Kit.
# Sign up at https://kit.com, then get your API key from Settings → Developer.
# KIT_API_KEY="..."
# KIT_FORM_ID="..."   # optional — attaches subscribers to a specific form
