# SMTP — support-form notifications (src/lib/smtp.ts, /api/support). Configured
# for Zoho Mail by default; works with any standard SMTP provider.
# Zoho: use an app-specific password if 2FA is on (recommended) rather than
# your account password: https://accounts.zoho.com/home#security/app-passwords
SMTP_HOST="smtp.zoho.com"
SMTP_PORT="587"
SMTP_USER="support@buygiftcards.online"
SMTP_PASS="..."
SMTP_FROM="BuyGiftCards.online Support <support@buygiftcards.online>"
SUPPORT_INBOX_EMAIL="support@buygiftcards.online"

# ---------------------------------------------------------------------------
# Country Storefront & Multi-Country Property Configuration
# ---------------------------------------------------------------------------
# The application automatically resolves the active country from the domain:
#   - buygiftcards.online     -> US (reads `env-us` / `.env-us` / `US_*`)
#   - ca.buygiftcards.online  -> CA (reads `env-ca` / `.env-ca` / `CA_*`)
#   - sg.buygiftcards.online  -> SG (reads `env-sg` / `.env-sg` / `SG_*`)
#   - uk.buygiftcards.online  -> UK (reads `env-uk` / `.env-uk` / `UK_*`)
#   - au.buygiftcards.online  -> AU (reads `env-au` / `.env-au` / `AU_*`)
# You can also override per country in a single environment using prefixes:
#   US_GIFTCARD_PROVIDER="zendit", CA_GIFTCARD_PROVIDER="tango", SG_GIFTCARD_PROVIDER="zendit"
#   CA_PAYPAL_CLIENT_ID="...", CA_PAYPAL_CLIENT_SECRET="...", CA_PAYPAL_CURRENCY="CAD"
#   SG_PAYPAL_CLIENT_ID="...", SG_PAYPAL_CLIENT_SECRET="...", SG_PAYPAL_CURRENCY="SGD"
APP_COUNTRY="US"
NEXT_PUBLIC_COUNTRY="US"

# ---------------------------------------------------------------------------
# Gift Card Fulfillment Provider selection: "zendit" or "tango"
# ---------------------------------------------------------------------------
GIFTCARD_PROVIDER="zendit"

# ---------------------------------------------------------------------------
# Zendit — PRIMARY live gift-card & voucher fulfillment provider
# ---------------------------------------------------------------------------
# API documentation: https://developers.zendit.io/api/
# Base URL: https://api.zendit.io/v1
# Once ZENDIT_API_KEY is set, ZenditProvider activates automatically and
# takes priority over Tango. Run `npm run zendit:catalog` to fetch available
# voucher offers and verify BRAND_TO_ZENDIT_OFFER in src/lib/giftcard-provider.ts.
ZENDIT_API_KEY="prod_..."
ZENDIT_API_BASE_URL="https://api.zendit.io/v1"
ZENDIT_USERNAME="sri@techladder.io"

# ---------------------------------------------------------------------------
# eGifter Merchandise Return API — Physical Gift Card Fulfillment (`src/lib/egifter.ts`)
# ---------------------------------------------------------------------------
# OpenAPI v1 spec:
#   - Production: https://merchreturns-api.egifter.com
#   - Stage:      https://stage-merchreturns-api.egifter.com
# Used automatically whenever `deliveryType === "physical"` since Zendit only
# fulfills digital eGift vouchers.
# Token Exchange (`POST /v1/Tokens`) authenticates using `Email` and `AccessToken`
# headers and caches the returned Bearer token across its lifecycle.
EGIFTER_API_BASE_URL="https://merchreturns-api.egifter.com"
EGIFTER_EMAIL="sri@techladder.io"
EGIFTER_ACCESS_TOKEN="..."
EGIFTER_WEBHOOK_URL="https://buygiftcards.online/api/webhooks/egifter"

# ---------------------------------------------------------------------------
# Tango Card RaaS API — real gift-card fulfillment (src/lib/giftcard-provider.ts).
# Leave unset to keep running in demo mode (non-redeemable placeholder codes).
# Get these from Tango after your application is approved: https://developers.tangocard.com
TANGO_API_BASE_URL="https://api.tangocard.com/raas/v2"
TANGO_PLATFORM_NAME="QAPlatform2"
TANGO_PLATFORM_KEY="apYPfT6HNONpDRUj3CLGWYt7gvIHONpDRUYPfT6Hj"
TANGO_ACCOUNT_IDENTIFIER="testing1234account"
TANGO_CUSTOMER_IDENTIFIER="customer-5554"

# Kit.com (formerly ConvertKit) — newsletter signups & post-purchase Trustpilot review workflow
# (src/lib/newsletter.ts, /api/subscribe, /api/workflows/trustpilot-invites).
# Sign up at https://kit.com, then get your v4 API key from Settings → Developer.
# KIT_API_KEY="..."
# KIT_FORM_ID="..."                     # optional — attaches newsletter subscribers to a form
# KIT_TRUSTPILOT_SEQUENCE_ID="..."      # Kit.com Sequence ID configured with 1-3 day delay for Trustpilot review invites
# KIT_TRUSTPILOT_TAG_ID="..."           # optional — Kit.com Tag ID (e.g. "completed-order") to trigger Visual Automations
# TRUSTPILOT_AFS_EMAIL="..."            # optional — Trustpilot Automatic Feedback Service (AFS) unique BCC address (e.g. buygiftcards.online+...@invite.trustpilot.com)
