# next-auth@beta declares an optional peer on nodemailer ^7||^8 (used only by
# its Email/magic-link provider, which this app doesn't use) — we run
# nodemailer 9.x for our own Zoho SMTP support-notification sender
# (src/lib/smtp.ts). legacy-peer-deps lets npm install proceed without that
# unrelated optional peer blocking the install, here and on Vercel.
legacy-peer-deps=true
