generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  PENDING
  PAID
  FULFILLED
  FAILED
  REFUNDED
}

enum DeliveryType {
  EGIFT
  PHYSICAL
}

model Order {
  id                    String      @id @default(cuid())
  orderNumber           String      @unique
  customerEmail         String
  status                OrderStatus @default(PENDING)
  subtotalCents         Int
  totalCents             Int
  taxCents               Int?
  currency              String      @default("usd")
  stripeCheckoutSessionId String    @unique
  stripePaymentIntentId  String?
  // Billing address Stripe collected at checkout (also what Stripe Tax used
  // to calculate tax jurisdiction) — captured from the webhook's
  // customer_details.address so we keep a record of it, not just Stripe.
  billingLine1          String?
  billingLine2          String?
  billingCity            String?
  billingState           String?
  billingPostalCode      String?
  billingCountry          String?
  // Tracks the confirmation email specifically, separate from `status`
  // (which is about payment/fulfillment). A NULL emailSentAt with a
  // populated emailError means Resend rejected or failed the send — the
  // order is still fully fulfilled (codes exist), just not yet confirmed
  // by email.
  emailSentAt            DateTime?
  emailError             String?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  items                 OrderItem[]
  // Optional: set at checkout time when the customer was signed in, so their
  // order history can be looked up by account instead of just by email.
  // Nullable — guest checkout (no account) remains fully supported.
  user                  User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId                String?

  @@index([customerEmail])
  @@index([userId])
}

model OrderItem {
  id            String       @id @default(cuid())
  order         Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId       String
  brandSlug     String
  brandName     String
  denomCents    Int
  quantity      Int
  deliveryType  DeliveryType
  // Vercel Blob URL for a customer-uploaded photo (currently Visa only —
  // Brand.supportsCustomPhoto). Purely cosmetic, shown on the order page
  // and confirmation email; never sent to the card issuer.
  customPhotoUrl String?
  codes         GiftCardCode[]
}

model GiftCardCode {
  id          String    @id @default(cuid())
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  orderItemId String
  code        String
  pin         String
  isDemo      Boolean   @default(true)
  createdAt   DateTime  @default(now())
}

enum BusinessRequestStatus {
  DRAFTED   // Stripe draft invoice created, not yet sent — pending internal review
  SENT      // A human reviewed it and finalized/sent the Stripe invoice
  DECLINED
}

// Corporate/bulk order requests (Stripe Invoicing product). Deliberately
// creates a DRAFT invoice only — a person reviews and sends it from the
// Stripe Dashboard, rather than auto-emailing a real invoice to a business
// customer straight off a web form.
model BusinessInvoiceRequest {
  id               String                @id @default(cuid())
  companyName      String
  contactName      String
  email            String
  phone            String?
  notes            String?
  totalCents       Int
  stripeCustomerId String
  stripeInvoiceId  String                @unique
  status           BusinessRequestStatus @default(DRAFTED)
  createdAt        DateTime              @default(now())
  items            BusinessInvoiceItem[]
}

// Kept in our own DB regardless of whether the Kit.com (ConvertKit) API call
// succeeds — so a signup is never lost just because that integration is
// unconfigured or briefly down. See src/lib/newsletter.ts.
model NewsletterSubscriber {
  id            String   @id @default(cuid())
  email         String   @unique
  subscribedAt  DateTime @default(now())
  syncedToKit   Boolean  @default(false)
}

model BusinessInvoiceItem {
  id          String                  @id @default(cuid())
  request     BusinessInvoiceRequest  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestId   String
  brandSlug   String
  brandName   String
  denomCents  Int
  quantity    Int
}

// ---- Accounts (Auth.js / next-auth v5 + @auth/prisma-adapter) ----
// Session strategy is "jwt" (required alongside the Credentials provider),
// so the Session table below exists to satisfy the PrismaAdapter's schema
// contract but isn't actually read from at runtime — Account is what
// matters, since it's how a Google/Apple/Facebook login gets linked to a
// User row.
model User {
  id             String    @id @default(cuid())
  email          String    @unique
  emailVerified  DateTime?
  firstName      String?
  lastName       String?
  phone          String?
  image          String?
  // Null for accounts created purely via an OAuth provider (no password set).
  passwordHash   String?
  marketingOptIn Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  accounts       Account[]
  sessions       Session[]
  orders         Order[]
  resetTokens    PasswordResetToken[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Our own table for the "Forgot password" flow — separate from
// VerificationToken above (which Auth.js reserves for magic-link email
// sign-in, a feature we don't use). One-time use: usedAt is set the moment
// the token is redeemed so it can't be replayed.
model PasswordResetToken {
  id        String    @id @default(cuid())
  token     String    @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}
